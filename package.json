{
  "name": "phpdocwiki",
  "publisher": "finleydab",
  "displayName": "PHPDoc Wiki",
  "description": "Builds a wiki from PHPDoc comments in your codebase.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/finleyaa/phpdocwiki.git"
  },
  "license": "GPL-3.0",
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "PHPDoc Wiki",
      "type": "object",
      "properties": {
        "phpdocwiki.excludePaths": {
          "type": "array",
          "default": [],
          "description": "Ignore paths for PHPDoc Wiki. Will be added to **/{excludePaths}/**. If empty, **/vendor/** is ignored."
        },
        "phpdocwiki.includePaths": {
          "type": "array",
          "default": [],
          "description": "Include paths for PHPDoc Wiki. Will be added to **/{includePaths}/**/*.php. If empty, all PHP files are included."
        }
      }
    },
    "commands": [
      {
        "command": "phpdocwiki.refresh",
        "title": "Refresh",
        "category": "PHPDoc Wiki"
      },
      {
        "command": "phpdocwiki.search",
        "title": "Search",
        "category": "PHPDoc Wiki"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "phpdocwiki.explorer",
          "name": "PHPDoc Wiki"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
